# Copy to .env and change secrets before sharing a deployment.
# This file is the single place to see every configurable value.

# PostgreSQL (used by docker compose and backend defaults)
POSTGRES_DB=krushimart
POSTGRES_USER=krushimart
POSTGRES_PASSWORD=krushimart_dev

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/krushimart
DB_USERNAME=krushimart
DB_PASSWORD=krushimart_dev
JWT_SECRET=dev-only-secret-change-me-before-any-shared-deployment-32chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=true

# AI service
AI_PROVIDER=heuristic
AI_MATCH_THRESHOLD=0.60

# Frontend (Vite reads VITE_* at build time)
# true = in-browser mock API (works without backend)
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api
